{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T&T Nhân Số Học App",
  "version": "1.9.0",
  "identifier": "com.tandthoanggiaroyal.nhansohoc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "T&T Nhân Số Học — Giải Mã Năng Lượng Số",
        "width": 1100,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
